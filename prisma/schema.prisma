generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  secondme_id       String    @unique
  access_token      String    // Required access token
  refresh_token     String?   // Refresh token
  token_expires_at  DateTime? // Token expiry time

  // User profile
  nickname          String?
  avatar            String?
  bio               String?

  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relations
  jazz_tracks       JazzTrack[]

  @@map("users")
}

model JazzTrack {
  id                String   @id
  user_id           String?
  user              User?    @relation(fields: [user_id], references: [id])

  // Cocktail parameters
  base_spirit       String   // whiskey | gin | rum | tequila
  ingredients       String   // JSON array: ["lemon","mint"]
  mood              String   // calm | sad | mysterious | romantic | energetic
  mood_intensity    Int      // 1-5
  ice_level         String   // none | light | heavy
  shake_level       String   // soft | medium | hard

  // Track information
  track_name_en     String
  track_name_zh     String
  poem_en           String   // JSON array of four English lines
  poem_zh           String   // JSON array of four Chinese lines

  // Music parameters
  bpm               Int
  key               String   // "C Major", "A Minor"
  mode              String   // major | minor | diminished | major7 | mixolydian
  time_signature    String   // "4/4"
  style             String   // blues | swing | latin | experimental

  // Music data
  chord_progression String   // JSON array: ["Cmaj7","Am7","Dm7","G7"]
  melody            String   // JSON array: [{"note":"C4","duration":"4n","time":0}...]
  instruments       String   // JSON array: ["piano","bass","drums"]

  // Metadata
  play_count        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("jazz_tracks")
  @@index([base_spirit])
  @@index([mood])
  @@index([user_id])
}
